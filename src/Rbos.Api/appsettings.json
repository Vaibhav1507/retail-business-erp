{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AiPerformance": {
    "GeminiAttemptTimeoutSeconds": 18,
    "GroqAttemptTimeoutSeconds": 12
  },
  "Ocr": {
    "TimeoutSeconds": 12
  },
  "AiGateway": {
    "Enabled": false,
    "AllowPaidProviders": false,
    "GlobalMonthlyBudgetInr": 1500,
    "PerTenantMonthlyBudgetInr": 50,
    "BudgetWarningThreshold": 0.75,
    "RequestTimeoutSeconds": 100,
    "InvoiceExtractionMaxOutputTokens": 8192,
    "QuotaCooldownSeconds": 60,
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerCooldownSeconds": 30,
    "Providers": {
      "Gemini": { "Enabled": false },
      "Groq": { "Enabled": false }
    },
    "Features": {
      "InvoiceExtraction": { "Enabled": true },
      "InvoiceItemTagExtraction": { "Enabled": true },
      "CatalogueExtraction": { "Enabled": true },
      "VoiceIntent": { "Enabled": true },
      "VoiceTranscription": { "Enabled": true }
    },
    "Credentials": []
  },
  "Groq": {
    "WhisperEnabled": false,
    "ItemTagFallbackEnabled": false,
    "WhisperModel": "whisper-large-v3-turbo",
    "VoiceIntentEnabled": false,
    "VoiceIntentModel": "qwen/qwen3.8-27b",
    "InvoiceFallbackEnabled": false
  },
  "VoiceIntent": {
    "Enabled": false
  },
  "Gemini": {
    "VoiceIntentEnabled": false,
    "VoiceIntentModel": "gemini-3.5-flash"
  }
}
